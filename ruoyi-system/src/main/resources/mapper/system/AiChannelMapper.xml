<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiChannelMapper">

    <resultMap type="AiChannel" id="AiChannelResult">
        <result property="channelId"       column="channel_id"        />
        <result property="channelName"     column="channel_name"      />
        <result property="channelCode"     column="channel_code"      />
        <result property="channelType"     column="channel_type"      />
        <result property="isCustom"        column="is_custom"         />
        <result property="baseUrl"         column="base_url"          />
        <result property="apiKey"          column="api_key"           />
        <result property="healthCheckUri"  column="health_check_uri"  />
        <result property="healthStatus"    column="health_status"     />
        <result property="healthCheckTime" column="health_check_time" />
        <result property="healthFailCount" column="health_fail_count" />
        <result property="status"          column="status"            />
        <result property="delFlag"         column="del_flag"          />
        <result property="createBy"        column="create_by"         />
        <result property="createTime"      column="create_time"       />
        <result property="updateBy"        column="update_by"         />
        <result property="updateTime"      column="update_time"       />
        <result property="remark"          column="remark"            />
    </resultMap>

    <sql id="selectAiChannelVo">
        select channel_id, channel_name, channel_code, channel_type, is_custom, base_url, api_key,
               health_check_uri, health_status, health_check_time, health_fail_count,
               status, del_flag, create_by, create_time, update_by, update_time, remark
        from ai_channel
    </sql>

    <select id="selectAiChannelById" parameterType="Long" resultMap="AiChannelResult">
        <include refid="selectAiChannelVo"/>
        where del_flag = '0' and channel_id = #{channelId}
    </select>

    <select id="selectAiChannelList" parameterType="AiChannel" resultMap="AiChannelResult">
        <include refid="selectAiChannelVo"/>
        <where>
            del_flag = '0'
            <if test="channelName != null and channelName != ''">
                AND channel_name like concat('%', #{channelName}, '%')
            </if>
            <if test="channelCode != null and channelCode != ''">
                AND channel_code like concat('%', #{channelCode}, '%')
            </if>
            <if test="channelType != null and channelType != ''">
                AND channel_type = #{channelType}
            </if>
            <if test="healthStatus != null and healthStatus != ''">
                AND health_status = #{healthStatus}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by channel_id desc
    </select>

    <insert id="insertAiChannel" parameterType="AiChannel" useGeneratedKeys="true" keyProperty="channelId">
        insert into ai_channel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="channelName != null and channelName != ''">channel_name,</if>
            <if test="channelCode != null and channelCode != ''">channel_code,</if>
            <if test="channelType != null and channelType != ''">channel_type,</if>
            <if test="isCustom != null and isCustom != ''">is_custom,</if>
            <if test="baseUrl != null and baseUrl != ''">base_url,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="healthCheckUri != null and healthCheckUri != ''">health_check_uri,</if>
            <if test="healthStatus != null and healthStatus != ''">health_status,</if>
            <if test="healthCheckTime != null">health_check_time,</if>
            <if test="healthFailCount != null">health_fail_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="channelName != null and channelName != ''">#{channelName},</if>
            <if test="channelCode != null and channelCode != ''">#{channelCode},</if>
            <if test="channelType != null and channelType != ''">#{channelType},</if>
            <if test="isCustom != null and isCustom != ''">#{isCustom},</if>
            <if test="baseUrl != null and baseUrl != ''">#{baseUrl},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="healthCheckUri != null and healthCheckUri != ''">#{healthCheckUri},</if>
            <if test="healthStatus != null and healthStatus != ''">#{healthStatus},</if>
            <if test="healthCheckTime != null">#{healthCheckTime},</if>
            <if test="healthFailCount != null">#{healthFailCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiChannel" parameterType="AiChannel">
        update ai_channel
        <trim prefix="SET" suffixOverrides=",">
            <if test="channelName != null and channelName != ''">channel_name = #{channelName},</if>
            <if test="channelCode != null and channelCode != ''">channel_code = #{channelCode},</if>
            <if test="channelType != null and channelType != ''">channel_type = #{channelType},</if>
            <if test="isCustom != null and isCustom != ''">is_custom = #{isCustom},</if>
            <if test="baseUrl != null and baseUrl != ''">base_url = #{baseUrl},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="healthCheckUri != null and healthCheckUri != ''">health_check_uri = #{healthCheckUri},</if>
            <if test="healthStatus != null and healthStatus != ''">health_status = #{healthStatus},</if>
            <if test="healthCheckTime != null">health_check_time = #{healthCheckTime},</if>
            <if test="healthFailCount != null">health_fail_count = #{healthFailCount},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where channel_id = #{channelId}
    </update>

    <select id="selectAiChannelByCodeIncludeDeleted" parameterType="String" resultMap="AiChannelResult">
        <include refid="selectAiChannelVo"/>
        where channel_code = #{channelCode}
        order by channel_id desc limit 1
    </select>

    <update id="reactivateAiChannel" parameterType="AiChannel">
        update ai_channel
           set del_flag = '0',
               status = '0',
               channel_name = #{channelName},
               channel_type = #{channelType},
               is_custom = #{isCustom},
               base_url = #{baseUrl},
               api_key = #{apiKey},
               health_check_uri = #{healthCheckUri},
               health_status = #{healthStatus},
               health_fail_count = #{healthFailCount},
               remark = #{remark},
               update_by = #{updateBy},
               update_time = sysdate()
         where channel_id = #{channelId}
    </update>

    <delete id="deleteAiChannelById" parameterType="Long">
        delete from ai_channel where channel_id = #{channelId}
    </delete>

    <delete id="deleteAiChannelByIds" parameterType="Long">
        delete from ai_channel where channel_id in
        <foreach item="channelId" collection="array" open="(" separator="," close=")">
            #{channelId}
        </foreach>
    </delete>

    <!--
      渠道健康聚合(首页)。
      healthStatus: 0未知 1正常 2异常;status: 0启用 1停用;delFlag 排除。
      同一渠道两个维度都可能有问题(status 启用但 health 异常),所以独立计数。
    -->
    <select id="selectChannelHealth" resultType="map">
        select
            count(1)                                                              as total,
            sum(case when status = '0' and del_flag = '0' then 1 else 0 end)       as enabled,
            sum(case when health_status = '1' and status = '0' and del_flag = '0' then 1 else 0 end) as healthy,
            sum(case when health_status = '2' and status = '0' and del_flag = '0' then 1 else 0 end) as unhealthy,
            sum(case when health_status = '0' and status = '0' and del_flag = '0' then 1 else 0 end) as unknown
        from ai_channel
        where del_flag = '0'
    </select>

</mapper>
