<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiModelMapper">

    <resultMap type="AiModel" id="AiModelResult">
        <result property="modelId"          column="model_id"          />
        <result property="modelCode"        column="model_code"        />
        <result property="displayName"      column="display_name"      />
        <result property="modelType"        column="model_type"        />
        <result property="contextWindow"    column="context_window"    />
        <result property="maxOutputTokens"  column="max_output_tokens" />
        <result property="reasoningEnabled" column="reasoning_enabled" />
        <result property="visionEnabled"    column="vision_enabled"    />
        <result property="inputModalities" column="input_modalities" />
        <result property="sort"             column="sort"              />
        <result property="status"           column="status"            />
        <result property="visibility"       column="visibility"        />
        <result property="ownerUserId"      column="owner_user_id"     />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
    </resultMap>

    <sql id="selectAiModelVo">
        select model_id, model_code, display_name, model_type, context_window,
               max_output_tokens, reasoning_enabled, vision_enabled, input_modalities, sort, status,
               visibility, owner_user_id, del_flag,
               create_by, create_time, update_by, update_time, remark
        from ai_model
    </sql>

    <select id="selectAiModelById" parameterType="Long" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        where del_flag = '0' and model_id = #{modelId}
    </select>

    <select id="selectAiModelByModelCode" parameterType="String" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        where del_flag = '0' and model_code = #{modelCode}
    </select>

    <select id="selectAiModelByCodeIncludeDeleted" parameterType="String" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        where model_code = #{modelCode}
        order by model_id desc limit 1
    </select>

    <select id="selectAiModelList" parameterType="AiModel" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        <where>
            del_flag = '0'
            <if test="modelCode != null and modelCode != ''">
                AND model_code like concat('%', #{modelCode}, '%')
            </if>
            <if test="displayName != null and displayName != ''">
                AND display_name like concat('%', #{displayName}, '%')
            </if>
            <if test="modelType != null and modelType != ''">
                AND model_type = #{modelType}
            </if>
            <if test="reasoningEnabled != null and reasoningEnabled != ''">
                AND reasoning_enabled = #{reasoningEnabled}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="visibility != null and visibility != ''">
                AND visibility = #{visibility}
            </if>
            <if test="ownerUserId != null">
                AND owner_user_id = #{ownerUserId}
            </if>
        </where>
        order by sort asc, model_id desc
    </select>

    <insert id="insertAiModel" parameterType="AiModel" useGeneratedKeys="true" keyProperty="modelId">
        insert into ai_model
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="modelCode != null and modelCode != ''">model_code,</if>
            <if test="displayName != null and displayName != ''">display_name,</if>
            <if test="modelType != null and modelType != ''">model_type,</if>
            <if test="contextWindow != null">context_window,</if>
            <if test="maxOutputTokens != null">max_output_tokens,</if>
            <if test="reasoningEnabled != null and reasoningEnabled != ''">reasoning_enabled,</if>
            <if test="visionEnabled != null and visionEnabled != ''">vision_enabled,</if>
            <if test="inputModalities != null">input_modalities,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="visibility != null and visibility != ''">visibility,</if>
            <if test="ownerUserId != null">owner_user_id,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="modelCode != null and modelCode != ''">#{modelCode},</if>
            <if test="displayName != null and displayName != ''">#{displayName},</if>
            <if test="modelType != null and modelType != ''">#{modelType},</if>
            <if test="contextWindow != null">#{contextWindow},</if>
            <if test="maxOutputTokens != null">#{maxOutputTokens},</if>
            <if test="reasoningEnabled != null and reasoningEnabled != ''">#{reasoningEnabled},</if>
            <if test="visionEnabled != null and visionEnabled != ''">#{visionEnabled},</if>
            <if test="inputModalities != null">#{inputModalities},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="visibility != null and visibility != ''">#{visibility},</if>
            <if test="ownerUserId != null">#{ownerUserId},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiModel" parameterType="AiModel">
        update ai_model
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelCode != null and modelCode != ''">model_code = #{modelCode},</if>
            <if test="displayName != null and displayName != ''">display_name = #{displayName},</if>
            <if test="modelType != null and modelType != ''">model_type = #{modelType},</if>
            <if test="contextWindow != null">context_window = #{contextWindow},</if>
            <if test="maxOutputTokens != null">max_output_tokens = #{maxOutputTokens},</if>
            <if test="reasoningEnabled != null and reasoningEnabled != ''">reasoning_enabled = #{reasoningEnabled},</if>
            <if test="visionEnabled != null and visionEnabled != ''">vision_enabled = #{visionEnabled},</if>
            <if test="inputModalities != null">input_modalities = #{inputModalities},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="visibility != null and visibility != ''">visibility = #{visibility},</if>
            <if test="ownerUserId != null">owner_user_id = #{ownerUserId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where model_id = #{modelId}
    </update>

    <update id="reactivateAiModel" parameterType="AiModel">
        update ai_model
           set del_flag = '0',
               status = '0',
               display_name = #{displayName},
               model_type = #{modelType},
               context_window = #{contextWindow},
               max_output_tokens = #{maxOutputTokens},
               reasoning_enabled = #{reasoningEnabled},
               vision_enabled = #{visionEnabled},
               input_modalities = #{inputModalities},
               sort = #{sort},
               remark = #{remark},
               update_by = #{updateBy},
               update_time = sysdate()
         where model_id = #{modelId}
    </update>

    <delete id="deleteAiModelById" parameterType="Long">
        delete from ai_model where model_id = #{modelId}
    </delete>

    <delete id="deleteAiModelByIds" parameterType="Long">
        delete from ai_model where model_id in
        <foreach item="modelId" collection="array" open="(" separator="," close=")">
            #{modelId}
        </foreach>
    </delete>

</mapper>
