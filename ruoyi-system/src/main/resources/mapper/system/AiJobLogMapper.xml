<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiJobLogMapper">

    <resultMap type="AiJobLog" id="AiJobLogResult">
        <result property="logId"          column="log_id"          />
        <result property="jobId"          column="job_id"          />
        <result property="jobName"        column="job_name"        />
        <result property="agentId"        column="agent_id"        />
        <result property="scheduledTime"  column="scheduled_time"  />
        <result property="fireTime"       column="fire_time"       />
        <result property="runId"          column="run_id"          />
        <result property="sessionId"      column="session_id"      />
        <result property="status"         column="status"          />
        <result property="skipReason"     column="skip_reason"     />
        <result property="retryNo"        column="retry_no"        />
        <result property="durationMs"     column="duration_ms"     />
        <result property="tokensUsed"     column="tokens_used"     />
        <result property="resultSummary"  column="result_summary"  />
        <result property="errorMessage"   column="error_message"   />
        <result property="createTime"     column="create_time"     />
    </resultMap>

    <sql id="selectAiJobLogVo">
        select l.log_id, l.job_id, l.job_name, l.agent_id, l.scheduled_time, l.fire_time,
               l.run_id, l.session_id, l.status, l.skip_reason, l.retry_no, l.duration_ms,
               l.tokens_used, l.result_summary, l.error_message, l.create_time
          from ai_job_log l
    </sql>

    <select id="selectAiJobLogById" parameterType="Long" resultMap="AiJobLogResult">
        <include refid="selectAiJobLogVo"/>
        where l.log_id = #{logId}
    </select>

    <!-- 列表 join ai_job:非管理员通过 ownerUserId 过滤仅本人任务的日志 -->
    <select id="selectAiJobLogList" parameterType="AiJobLog" resultMap="AiJobLogResult">
        select l.log_id, l.job_id, l.job_name, l.agent_id, l.scheduled_time, l.fire_time,
               l.run_id, l.session_id, l.status, l.skip_reason, l.retry_no, l.duration_ms,
               l.tokens_used, l.result_summary, l.error_message, l.create_time
          from ai_job_log l
          left join ai_job j on j.job_id = l.job_id
        <where>
            <if test="jobId != null">
                AND l.job_id = #{jobId}
            </if>
            <if test="jobName != null and jobName != ''">
                AND l.job_name like concat('%', #{jobName}, '%')
            </if>
            <if test="agentId != null">
                AND l.agent_id = #{agentId}
            </if>
            <if test="runId != null and runId != ''">
                AND l.run_id = #{runId}
            </if>
            <if test="sessionId != null and sessionId != ''">
                AND l.session_id = #{sessionId}
            </if>
            <if test="status != null and status != ''">
                AND l.status = #{status}
            </if>
            <if test="ownerUserId != null">
                AND j.owner_user_id = #{ownerUserId}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND l.fire_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND l.fire_time &lt;= #{params.endTime}
            </if>
        </where>
        order by l.log_id desc
    </select>

    <insert id="insertAiJobLog" parameterType="AiJobLog" useGeneratedKeys="true" keyProperty="logId">
        insert into ai_job_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="jobId != null">job_id,</if>
            <if test="jobName != null and jobName != ''">job_name,</if>
            <if test="agentId != null">agent_id,</if>
            <if test="scheduledTime != null">scheduled_time,</if>
            <if test="fireTime != null">fire_time,</if>
            <if test="runId != null">run_id,</if>
            <if test="sessionId != null">session_id,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="skipReason != null">skip_reason,</if>
            <if test="retryNo != null">retry_no,</if>
            <if test="durationMs != null">duration_ms,</if>
            <if test="tokensUsed != null">tokens_used,</if>
            <if test="resultSummary != null">result_summary,</if>
            <if test="errorMessage != null">error_message,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="jobId != null">#{jobId},</if>
            <if test="jobName != null and jobName != ''">#{jobName},</if>
            <if test="agentId != null">#{agentId},</if>
            <if test="scheduledTime != null">#{scheduledTime},</if>
            <if test="fireTime != null">#{fireTime},</if>
            <if test="runId != null">#{runId},</if>
            <if test="sessionId != null">#{sessionId},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="skipReason != null">#{skipReason},</if>
            <if test="retryNo != null">#{retryNo},</if>
            <if test="durationMs != null">#{durationMs},</if>
            <if test="tokensUsed != null">#{tokensUsed},</if>
            <if test="resultSummary != null">#{resultSummary},</if>
            <if test="errorMessage != null">#{errorMessage},</if>
            sysdate()
        </trim>
    </insert>

    <!-- 对账回填终态:只更新仍为 DISPATCHED 的行,避免覆盖人工改过的记录 -->
    <update id="updateTerminalByRunId" parameterType="AiJobLog">
        update ai_job_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="durationMs != null">duration_ms = #{durationMs},</if>
            <if test="tokensUsed != null">tokens_used = #{tokensUsed},</if>
            <if test="resultSummary != null">result_summary = #{resultSummary},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
        </trim>
         where run_id = #{runId}
           and status = 'DISPATCHED'
    </update>

    <update id="updateAiJobLog" parameterType="AiJobLog">
        update ai_job_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="runId != null">run_id = #{runId},</if>
            <if test="sessionId != null">session_id = #{sessionId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="skipReason != null">skip_reason = #{skipReason},</if>
            <if test="retryNo != null">retry_no = #{retryNo},</if>
            <if test="durationMs != null">duration_ms = #{durationMs},</if>
            <if test="tokensUsed != null">tokens_used = #{tokensUsed},</if>
            <if test="resultSummary != null">result_summary = #{resultSummary},</if>
            <if test="errorMessage != null">error_message = #{errorMessage},</if>
        </trim>
         where log_id = #{logId}
    </update>

    <select id="selectPendingLogs" resultMap="AiJobLogResult">
        <include refid="selectAiJobLogVo"/>
         where l.status = 'DISPATCHED'
           and l.fire_time &lt; #{before}
         order by l.fire_time asc
         limit #{limit}
    </select>

    <delete id="deleteAiJobLogByIds" parameterType="Long">
        delete from ai_job_log where log_id in
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>

    <delete id="cleanExpiredLogs">
        delete from ai_job_log where create_time &lt; #{before}
    </delete>

</mapper>
