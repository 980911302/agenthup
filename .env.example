# 复制为 .env 后按部署环境填写；不要把 .env 提交到 Git。
# Spring Boot 不会自动加载该文件。启动前请由部署平台注入，或在本地执行：set -a && source .env && set +a

# AES-256 密钥：32 字节 Base64 编码值
RUOYI_ENCRYPT_KEY=

# Redis
REDIS_PASSWORD=

# JWT / Token 签名密钥（使用足够长的随机值）
TOKEN_SECRET=

# MySQL 主库
MYSQL_USERNAME=
MYSQL_PASSWORD=

# PostgreSQL 知识库从库
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# Neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Druid 管理控制台
DRUID_LOGIN_USERNAME=
DRUID_LOGIN_PASSWORD=
